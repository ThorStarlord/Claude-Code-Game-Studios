{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCGS portable task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "role",
    "runtime",
    "objective",
    "repository",
    "allowed_paths"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "role": {
      "type": "string",
      "pattern": "^ccgs-[a-z0-9-]+$"
    },
    "runtime": {
      "enum": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "autonomy": {
      "enum": [
        "collaborative",
        "guided",
        "autonomous"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_only": {
      "type": "boolean"
    }
  }
}
