{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCGS portable result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "runtime",
    "status",
    "base_commit",
    "worktree",
    "changed_files",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "runtime": {
      "enum": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "interrupted",
        "not_run"
      ]
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "worktree": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_path": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
